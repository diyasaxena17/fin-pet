{
  "name": "mochi",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22.12.0 <23", "pnpm": ">=10 <11" },
  "scripts": {
    "dev:api": "pnpm --filter @mochi/api dev",
