{
  "name": "@mochi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cmake -S . -B build && cmake --build build && ./build/mochi-api",
    "build": "cmake -S . -B build && cmake --build build",
    "start": "./build/mochi-api",
    "test": "cmake -S . -B build && cmake --build build && ctest --test-dir build --output-on-failure && tsx tests/contract_parity.ts && tsx tests/addendum_parity.ts",
    "typecheck": "cmake -S . -B build && cmake --build build",
    "test:hardware": "node tests/nfc_browser.mjs"
  },
  "dependencies": {
    "@mochi/contracts": "workspace:*",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "zod": "^4.0.0",
    "@mochi/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
